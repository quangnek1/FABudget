			var _currentInvestmentAmountUSDRemaining = fABudgetEditVm.CurrentInvestmentAmountEstimationUSD - fABudgetEditVm.BudgetSharing;
			if (/* totalBudgetEdit < _currentInvestmentAmountUSDRemaining  && */ fABudgetEditVm.AppropriatedBudgetNo != null && _currentInvestmentAmountUSDRemaining > 0)
			{
				fABudgetEditVm.BudgetRemaining = totalBudgetEdit - fABudgetEditVm.CurrentInvestmentAmountEstimationUSD;
				if (fABudgetEditVm.BudgetRemaining > 0)
				{
