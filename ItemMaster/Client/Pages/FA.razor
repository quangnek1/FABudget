	private void AppropriatedBudgetNoTextChanged(string? value)
	{
		// Gọi phương thức trong ViewModel để cập nhật danh sách
		// Update. Yêu cầu khi Add new, Budget remaining se = 0
		try
		{
			if (!string.IsNullOrEmpty(value))
			{
				string[] _value = value.Split(',');
				// Vì Budget remaining se = 0, nên chỗ này comment lại. Sau này nếu cần hiển thị thì lại hiện ra.
				// Mở toàn bộ phần comment là được. Bên thuộc tính vẫn dữ nguyên.

				total = 0;
				foreach (var item in _value)
				{
					var budgetRemining = fABudgetObjectVm.ListBudgetRemaining.Where(p => p.No == int.Parse(item)).SingleOrDefault()?.BudgetRemaining;
					if (budgetRemining != null)
					{
						total = total + budgetRemining;
					}
				}
				//	fABudgetRequestVm.UpdateBudgetRemaining(total, value);
				fABudgetRequestVm.AppropriatedBudgetNo = value;
			}
			else
			{
				//	fABudgetRequestVm.UpdateBudgetRemaining(null, null);
				total = 0;
				fABudgetRequestVm.AppropriatedBudgetNo = null;

			}
		}
		catch (Exception ex)
		{
			snackbar.Add(ex.Message, Severity.Warning);
		}

	}

	private void AppropriatedBudgetNoEditTextChanged(string? value)
	{
		// Gọi phương thức trong ViewModel để cập nhật danh sách
		// Update. Yêu cầu khi Add new, Budget remaining se = 0
		try
		{
			if (!string.IsNullOrEmpty(value))
			{
				string[] _value = value.Split(',').Select(x => x.Trim()).ToArray();
				// Vì Budget remaining se = 0, nên chỗ này comment lại. Sau này nếu cần hiển thị thì lại hiện ra.
				// Mở toàn bộ phần comment là được. Bên thuộc tính vẫn dữ nguyên.

				totalBudgetEdit = fABudgetEditVm.CurrentInvestmentAmountUSD == null ? _CurrentInvestmentAmountEstimationUSDTemp : 0;
				foreach (var item in _value)
				{
				//	var budgetRemining = fABudgetObjectVm.ListBudgetRemaining.Where(p => p.No == int.Parse(item)).SingleOrDefault()?.BudgetRemaining; Old
					var budgetRemining = fABudgetEditVm.ListBudgetRemainingEdit.Where(p => p.No == int.Parse(item)).SingleOrDefault()?.BudgetRemaining;// new
					if (budgetRemining != null)
					{
						if (fABudgetEditVm.CurrentInvestmentAmountUSD == null)
						{
							totalBudgetEdit += budgetRemining;
						}
						else
						{
							totalBudgetEdit = totalBudgetEdit + budgetRemining;

						}
					}
				}
				totalBudgetEdit = totalBudgetEdit + (fABudgetEditVm.CurrentInvestmentAmountUSD ?? 0);
				//	fABudgetRequestVm.UpdateBudgetRemaining(total, value);
				if (!string.IsNullOrEmpty(value))
				{
					// Loại bỏ khoảng trắng thừa giữa các dấu ','
					string cleanedValue = string.Join(",", value.Split(',')
																.Select(x => x.Trim()));

					fABudgetEditVm.AppropriatedBudgetNo = cleanedValue;
				}
				else
				{
					fABudgetEditVm.AppropriatedBudgetNo = null;
				}
			}
			else
			{
				//	fABudgetRequestVm.UpdateBudgetRemaining(null, null);
				totalBudgetEdit = fABudgetEditVm.CurrentInvestmentAmountUSD;
				fABudgetEditVm.AppropriatedBudgetNo = null;

			}
			UpdateValue(fABudgetEditVm.CurrentInvestmentAmountEstimationUSD);
		}
		catch (Exception ex)
		{
			snackbar.Add(ex.Message, Severity.Warning);
		}



	}
	private decimal? OnListEditBudgetRemainingChanged(FABudgetRequestEditVm requestEditVm)
	{
		decimal? result = 0;
		// Khi ListAddBudgetRemaining thay đổi, reset giá trị của Select
		//	fABudgetRequestVm.AppropriatedBudgetNo = null; // Reset giá trị được chọn
		if (string.IsNullOrEmpty(requestEditVm.AppropriatedBudgetNo))
		{
			optionsEdit = new List<string>();

		}
		else
		{
			//optionsEdit = new List<string>() { requestEditVm.AppropriatedBudgetNo }; // Reset danh sách selected values (nếu có)

			optionsEdit = requestEditVm.AppropriatedBudgetNo.Split(',').Select(x => x.Trim()).ToArray();


			if (fABudgetEditVm.CurrentInvestmentAmountUSD == null)
			{
				var _totalbudget = requestEditVm.BudgetCanUsing - requestEditVm.BudgetSharing;
				fABudgetEditVm.BudgetCanUsing = requestEditVm.CurrentInvestmentAmountEstimationUSD + _totalbudget;
				result = requestEditVm.CurrentInvestmentAmountEstimationUSD + _totalbudget;
			}
			else
			{
				var _totalbudget = fABudgetEditVm.CurrentInvestmentAmountEstimationUSD - fABudgetEditVm.CurrentInvestmentAmountUSD + requestEditVm.BudgetCanUsing - requestEditVm.BudgetSharing + fABudgetEditVm.CurrentInvestmentAmountUSD;
				fABudgetEditVm.BudgetCanUsing = _totalbudget;
				result = _totalbudget;
			}
		}

		StateHasChanged(); // Cập nhật lại UI
		return result;
	}
