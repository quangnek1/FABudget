<PageTitle>51期　設備計画</PageTitle>
<style type="text/css">
	.mud-table-head .header-centered th {
		text-align: center;
		/* font-size: 1.2em; */
	}


	.custom-flex {
		display: flex;
		align-items: center; /* Căn giữa các phần tử theo chiều dọc */
	}

		.custom-flex .mud-icon-button {
			margin: 0; /* Loại bỏ khoảng cách bên ngoài cho nút */
		}

		.custom-flex .mud-text-field {
			width: 50px;
			margin: 0; /* Loại bỏ khoảng cách bên ngoài cho ô nhập liệu */
			text-align: center; /* Căn giữa nội dung trong ô nhập liệu */
		}

	#tableMain .mud-table-container .mud-table-body {
		zoom: @_zoomContent %;
	}

	#tableMain .mud-table-container .mud-table-root {
		width: max-content;
	}

	.zoomable-table {
		--zoom-factor: @_zoom; /* Gán giá trị zoomFactor vào biến CSS */
	}

	.sticky-left {
		position: sticky; /* Đặt vị trí sticky cho cột */
		left: 0; /* Đặt vị trí bên trái */
		z-index: 2; /* Đảm bảo cột luôn ở trên cùng */
		/* background-color: white; */ /* Màu nền trắng để không bị che khuất */
		background-color: var(--mud-palette-background);
	}
	/* Hiệu ứng striped cho ô sticky */
	tbody tr:nth-child(odd) .sticky-left {
		background-color: #fafafa; /* Màu nền cho hàng lẻ */
	}

	tbody tr:nth-child(even) .sticky-left {
		background-color: white; /* Màu nền cho hàng chẵn */
	}
</style>




