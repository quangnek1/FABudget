	bool DisableInputEstimation = true;
	string _saveTempData { get; set; }
	private void AddSectionTextChanged(string value)
	{
		// Gọi phương thức trong ViewModel để cập nhật danh sách
		try
		{
			var sectionVm = dataVm.SectionVms.Where(p => p.SectionCode == value).SingleOrDefault();
			fABudgetRequestVm.UpdateSectionCode_Segment_SectionName(sectionVm);


			//
			if (_saveTempData == null)
			{
				_saveTempData = value;
			}
			else if (_saveTempData == value)
			{
				return;
			}

			ListAddBudgetRemaining = fABudgetObjectVm.ListBudgetRemaining.Where(p => p.Segment == sectionVm.Segment).ToList();
			if (ListAddBudgetRemaining.Count == 0)
			{
				fABudgetRequestVm.AppropriatedBudgetNo = null;
				DisableInputEstimation = true;
				fABudgetRequestVm.TinhToan_FixedAssetsAccountedAmountEstimationUSD = 0;
				fABudgetRequestVm.TinhToan2_FixedAssetsAccountedAmountEstimationUSD = 0;
				total = 0;
			}
			else
			{
				OnListAddBudgetRemainingChanged();
				DisableInputEstimation = false;
				total = 0;
				fABudgetRequestVm.AppropriatedBudgetNo = null;
				fABudgetRequestVm.TinhToan_FixedAssetsAccountedAmountEstimationUSD = 0;
				fABudgetRequestVm.TinhToan2_FixedAssetsAccountedAmountEstimationUSD = 0;
			}


		}
		catch (Exception)
		{
			snackbar.Add("Không tìm được giá trị.", Severity.Warning);
		}
		StateHasChanged();

	}
