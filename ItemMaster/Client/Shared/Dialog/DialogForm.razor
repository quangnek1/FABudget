@* @using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
 


@if (workFlowVm == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <div class="d-flex justify-content-center mt-8">
        <div style="max-width: 800px; min-width: 400px">
            <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
                <MudCard Elevation="4">
                    <MudCardContent>
                        <MudTextField T="string" Label="WorkFlow Name" Required="true" RequiredError="WorkFlow Name is required!" @bind-Value="@workFlowVm.CreateBy" />
                        <MudIconButton Icon="@Icons.Filled.Add" Color="Color.Tertiary"></MudIconButton>
                    </MudCardContent>
                    <MudCardContent Class="pa-0">
                        <MudTable Items="@workFlowVm.workFolowDetailVms" Hover="true" Breakpoint="Breakpoint.None" Dense="@true" Elevation="0">
                            <HeaderContent>
                                <MudTh>User</MudTh>
                                <MudTh>Type</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="User">
                                    <MudTextField Label="User"
                                              @bind-Value="context.UserCode"
                                              For="(() => context.UserCode)" />
                                    <MudSelect T="string" Label="User" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                        @if (workFlowVm.workFolowDetailVms.Count() > 0)
                                        {
                                        @foreach (var item in workFlowVm.workFolowDetailVms)
                                            {
                                            <MudSelectItem T="string" Value="item.UserCode" />
                                            }
                                        }
                                </MudSelect>

                            </MudTd>
                            <MudTd DataLabel="Type">
                                <MudNumericField Label="Type"
                                                 @bind-Value="context.Type"
                                                 For="(() => context.Type)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(!success)"
                               Class="ml-auto"
                               OnClick="@(()=>Save())">Save</MudButton>
                    <MudButton Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
                </MudCardActions>
            </MudCard>

            <MudExpansionPanels>
                <MudExpansionPanel Text="@($"Show Errors ({errors.Length})")">
                    @foreach (var error in errors)
                        {
                            <MudText Color="@Color.Error">@error</MudText>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudForm>
        </div>
    </div>
}
@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    public WorkFlowVm workFlowVm;

    protected async override Task OnInitializedAsync()
    {
        if (Id > 0)
            workFlowVm = await workFlowServices.GetDetails(Id);
        else
            workFlowVm = new WorkFlowVm();
    }
    protected async Task Save()
    {
        await workFlowServices.SaveWorkflow(workFlowVm);
        MudDialog.Close(DialogResult.Ok(workFlowVm.Id));
    }
    void Cancel() => MudDialog.Cancel();

    bool success;
    string[] errors = { };
    MudTextField<string> pwField1;
    MudForm form;
}
 *@